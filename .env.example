# LabRoute — keep real values in .env.local (or .env), never in Git.
# Process/hosting environment wins; .env.local takes precedence over .env.

PORT=3000
HOST=0.0.0.0

# Required for Neon. Use the pooled URL for the running app.
# Replace these example values using `neon deploy` / `neon env pull`.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Use Neon's direct URL for schema migrations/imports. If omitted, the migration
# command derives it by removing -pooler from a Neon hostname (not other hosts).
# For build setup, both URLs must target the same Neon endpoint and database.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Never fall back to /tmp if PostgreSQL is unavailable.
MOMENTS_STORAGE=postgres

# One-time setup without a local terminal: add this in Vercel's *Production*
# environment, then deploy the code using `npm run build:vercel` (vercel.json).
# Creates the schema and initial repository data before building the site.
# Off by default; preview/development/local/custom builds never initialize.
# After /api/health is healthy, remove the flag or set it to 0.
# MOMENTS_MIGRATE_ON_BUILD=1

# Optional: keep an existing production signing key while migrating sessions.
# Otherwise one key is generated in PostgreSQL and shared by all instances.
# MOMENTS_SECRET=use-a-random-secret-at-least-32-characters-long

# One photo per visitor every 30 minutes; independent network burst guard.
MOMENTS_COOLDOWN_MINUTES=30
MOMENTS_IP_LIMIT=50
# Maximum decoded bytes: 8 MiB on Node, capped at 3 MiB on Vercel.
# MOMENTS_MAX_UPLOAD_BYTES=8388608

# Optional email notifications. Uploads/review work without an email provider.
# auto | resend | webhook | formspree | none
MOMENTS_EMAIL_PROVIDER=auto
# RESEND_API_KEY=re_example
# RESEND_FROM=LabRoute <moments@yourdomain.com>
# MOMENTS_ADMIN_EMAILS=admin@example.com
# MOMENTS_WEBHOOK_URL=https://example.com/hooks/labroute
# MOMENTS_FORM_ENDPOINT=https://formspree.io/f/xvkoraeq
# Set MOMENTS_FORM_ENDPOINT=off to disable the existing Formspree fallback.
# PUBLIC_BASE_URL=https://labroute.vercel.app

# Legacy import ONLY. Neon-backed uploads do not require Vercel Blob.
# Set these when running `npm run db:import -- --from-blob` to copy existing data.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example
# BLOB_ACCESS=private

# ─────────────────────────────────────────────────────────────
# LabRoute · Lab Moments upload service
# Copy this file to .env and fill in what you need.
# ─────────────────────────────────────────────────────────────

# Port / interface (the server binds 0.0.0.0 so preview proxies work)
PORT=3000
HOST=0.0.0.0

# One photo per visitor every 30 minutes
MOMENTS_COOLDOWN_MINUTES=30

# Maximum decoded image size (bytes). Default: 8 MB
# MOMENTS_MAX_UPLOAD_BYTES=8388608

# Guard against one network uploading too many photos at once.
# Individual visitors still get their own 30-minute cooldown.
MOMENTS_IP_LIMIT=50

# Email delivery: auto | resend | webhook | formspree | none
# "auto" prefers Resend, then your webhook, then the Formspree form below.
MOMENTS_EMAIL_PROVIDER=auto

# Recommended: Resend sends to every admin in data/admins.json.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=LabRoute <moments@yourdomain.com>

# Optional override for who receives upload alerts.
# If omitted, every email in data/admins.json is used.
# MOMENTS_ADMIN_EMAILS=etini7809@gmail.com,osakioyaaika525@gmail.com

# Optional generic webhook (Google Apps Script, Slack relay, n8n, etc.)
# MOMENTS_WEBHOOK_URL=https://example.com/hooks/labroute

# The existing Formspree form used by the suggestion box. The form owner
# receives an email when a photo is submitted for review if no other provider
# is configured.
# Set to "off" to disable this fallback.
# MOMENTS_FORM_ENDPOINT=https://formspree.io/f/xvkoraeq

# Public origin used in notification emails (links + image URL).
# PUBLIC_BASE_URL=https://labroute.vercel.app

# Secret used to sign visitor cookies and admin sessions.
# A random one is generated in data/runtime/secret.key if omitted.
# REQUIRED on Vercel: every Function instance would otherwise mint its own
# temporary secret, randomly invalidating admin sessions and cooldowns.
# MOMENTS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─────────────────────────────────────────────────────────────
# Vercel deployment (labroute.vercel.app)
# The /api/* routes run as a Vercel Function (api/[...path].js).
# Connect a Blob store (Storage → Create → Blob → Private) and Vercel adds
# the credentials below automatically — you do not type them yourself.
# ─────────────────────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...   (added by Vercel)
# BLOB_STORE_ID=store_...                    (added by Vercel)

# Optional: how the Blob store was created. When omitted the service tries
# private first, then public, and remembers whichever works.
# BLOB_ACCESS=private

# Storage selection: auto | blob | local
# "auto" uses Vercel Blob when its credentials are present, otherwise disk
# (on Vercel that is temporary /tmp storage — fine for a demo, not durable).
# MOMENTS_STORAGE=auto

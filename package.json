{
  "name": "labroute",
  "version": "1.0.0",
  "private": true,
  "description": "LabRoute \u2014 UNIBEN ELA report repository with a community lab moments gallery.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "publish": "node tools/publish-moment.js",
    "build": "tsc -p tsconfig.neon.json && node tools/build.js",
    "db:migrate": "node tools/migrate-db.js",
    "db:import": "node tools/import-db.js",
    "test:postgres": "node --test tests/postgres.test.js",
    "test:e2e": "node tools/test-e2e.js",
    "build:vercel": "node tools/vercel-build.js",
    "test:vercel-setup": "node --test tests/vercel-build.test.js tests/vercel-setup.test.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "labroute",
    "uniben",
    "engineering",
    "lab-reports"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.11.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@neon/config": "^1.14.0",
    "@types/node": "^26.6.6",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{content/**/*.json,data/admins.json}"
    }
  },
  "rewrites": [
    {
      "source": "/content/(.*)",
      "destination": "/api?__labroute_path=content/$1"
    },
    {
      "source": "/assets/gallery/moments/(.*)",
      "destination": "/api/moment-image/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__labroute_path=$1"
    }
  ],
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist"
}
